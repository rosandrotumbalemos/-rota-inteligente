# Copie para .env e ajuste se precisar. Não coloque segredos reais neste arquivo.

# --- Núcleo de IA (rota_core) ---
# Caminhos relativos são resolvidos a partir da raiz do repositório.
ROTA_DATA_DIR=data
ROTA_OUTPUTS_DIR=outputs
ROTA_SEED=42
ROTA_N_CLUSTERS=4

